PROJECT_NAME="CIPHERTRACE X — Criminal Network Intelligence Platform"
VERSION="1.0.0-phase1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (SQLite default for local, PostgreSQL for production)
DATABASE_URL="sqlite:///./ciphertrace.db"
# PostgreSQL Example:
# DATABASE_URL="postgresql://ciphertrace:ciphertrace_secure_password_2026@localhost:5432/ciphertrace_db"

# Storage Directories
UPLOAD_DIR="./storage/evidence"
AUDIT_LOG_DIR="./storage/audit"

# Neo4j Graph Database (Phases 4-7)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="ciphertrace_neo4j_password_2026"

# Redis Task Queue & Cache
REDIS_URL="redis://localhost:6379/0"

# Cryptography & Security
DEFAULT_HASH_ALGO="SHA-256"
SECRET_KEY="ciphertrace-development-secret-key-change-in-production-32bytes"
